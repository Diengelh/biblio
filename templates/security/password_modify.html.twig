{% extends 'base.html.twig' %}

{% block title %}
    Formulaire de modification de mot de passe
{% endblock %}

{% block body %}
    <section class="container">
    <div>
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="d-flex justify-content-center alert alert-{{ type }}"> {{message}}</div>
            {% endfor %}
        {% endfor %}    
    </div>

    <h1>Formulaire de modification de mot de passe</h1>
    <div>
        {{ form_start(form) }}

            {{ form_row(form.old_password, { label: "Ancien mot de passe"}) }}

            {{ form_row(form.new_password)}}

            <input type="submit" value="Valider" class="btn btn-primary px-4">

        {{ form_end(form) }}    
    </div>
    
    </section>

{% endblock %}