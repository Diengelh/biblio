{% extends 'base.html.twig' %}

{% set action = app.current_route == "app_admin_book_new" ? "Ajout" : "Edtion" %}

{% block title %}{{action}} de Livre{% endblock %}

{% block body %}
<style>
    .example-wrapper { padding-top: 4em; padding-bottom: 2em; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <div class = 'w-50 m-auto'>
        <h1> Ajout de Livre</h1><br>

        {{form_start(form)}}
            {{form_row(form.title, {label: "Titre"})}}
            {{form_row(form.isbn, {label: "N° isbn"})}}
            {{form_row(form.cover, {label: "Photo De Couverture"})}}
            {{form_row(form.editedAt, {label: "Date d'Edition"})}}
            {{form_row(form.status, {label: "Status"})}}
            {# {{form_row(form.imageFile, {label: "Couverture(Vich)"})}} #}
            {{form_row(form.pageNumber, {label: "Nombre De Page"})}}
            {{form_row(form.editor, {label: "Editeur"})}}
            {{form_row(form.authors, {label: "Auteur(s)"})}}
            {{form_row(form.plot, {label: "Resumé"})}}
            {{form_row(form.imageFile, {label: "Photo de couverture"})}}
            <button type="submit" class="btn btn-primary px-4">envoyer</button>
        {{form_end(form)}}

    </div>
</div>
{% endblock %}
