{% extends 'base.html.twig' %}

{% block title %}Livres{% endblock %}

{% block body %}

<section class="container px-4">
    
    <h1>Livres</h1>

    {% for book in pagination %}
        
    <div class="card p-2 mb-1">
        <div class="card-title">
            <a href="{{path('app_admin_book_show', {id: book.id})}}" class="link-dark" title="Détails du livre">{{book.title}}</a>
        </div>
        <div class="card-body d-flex justify-content-between">
            <div>
                <div class="text-muted">Éditeur: {{book.editor.name}}</div>
                <div class="text-muted">Nombre de page: {{book.pageNumber}}</div>
            </div>
            <div>
                <div class="text-muted">Identifiant: {{book.id}}</div>
            </div>
        </div>
    </div>
    {% else %}
        Aucun enregistrement en base de données.
    {% endfor %}
    <div class="navigation mt-2">
		{{ knp_pagination_render(pagination) }}
	</div>
</section>
{% endblock %}
